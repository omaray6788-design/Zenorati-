# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CBE_SYNC_SECRET: Optional shared secret to authorize external Cloud Scheduler calls to POST /api/exchange-rate/cbe/cron.
CBE_SYNC_SECRET=""

# ZENORATI_OWNER_UID: Optional comma-separated Firebase UID(s) authorized as platform owner/admin in backend API checks.
# Note: Firestore security rules also check /admins/{uid}.
ZENORATI_OWNER_UID=""

# ZENORATI_OWNER_EMAIL: Optional comma-separated verified email(s) authorized as server-verified owner in backend API checks.
ZENORATI_OWNER_EMAIL=""

