{
  "entities": {
    "AdminMember": {
      "title": "AdminMember",
      "description": "Server/console-provisioned platform owner or administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["super_admin", "owner", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Independent user account profile with RBAC role, store assignment, and per-section permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "role": { "type": "string", "enum": ["super_admin", "store_owner", "manager", "staff", "viewer"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "tenantId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "businessName": { "type": "string", "minLength": 0, "maxLength": 100 },
        "permissions": { "type": "object" },
        "invitationId": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "accountStatus", "permissions", "createdAt", "updatedAt"]
    },
    "TenantMember": {
      "title": "TenantMember",
      "description": "Authorized non-owner staff/manager/viewer membership inside a specific store tenant.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "role": { "type": "string", "enum": ["manager", "staff", "viewer"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "permissions": { "type": "object" },
        "invitedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "tenantId", "email", "fullName", "role", "accountStatus", "permissions", "createdAt", "updatedAt"]
    },
    "RoleTemplate": {
      "title": "RoleTemplate",
      "description": "Platform default permission template for a canonical role.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["super_admin", "store_owner", "manager", "staff", "viewer"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 0, "maxLength": 240 },
        "permissions": { "type": "object" },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "label", "description", "permissions", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable append-only audit log of sensitive Super Admin actions and store inspections.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["user", "tenant", "invitation", "role_template", "system"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetLabel": { "type": "string", "minLength": 0, "maxLength": 160 },
        "details": { "type": "string", "minLength": 0, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "targetType", "targetId", "targetLabel", "details", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Hashed, invitation-only registration record supporting targeted user roles and store assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "codeHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "codePreview": { "type": "string", "minLength": 4, "maxLength": 32 },
        "label": { "type": "string", "minLength": 0, "maxLength": 120 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["active", "used", "revoked"] },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "targetEmail": { "type": "string", "minLength": 0, "maxLength": 160 },
        "targetFullName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "targetBusinessName": { "type": "string", "minLength": 0, "maxLength": 100 },
        "targetRole": { "type": "string", "enum": ["store_owner", "manager", "staff", "viewer"] },
        "targetTenantId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "targetPermissions": { "type": "object" },
        "resendCount": { "type": "integer" },
        "lastSentAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "revokedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "codeHash", "codePreview", "label", "createdByUid", "status", "maxUses", "usedCount", "expiresAt", "createdAt", "updatedAt"]
    },
    "InvitationRedemption": {
      "title": "InvitationRedemption",
      "description": "Immutable per-user audit record created atomically when an invitation is redeemed.",
      "type": "object",
      "properties": {
        "inviteId": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 40 },
        "redeemedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteId", "uid", "email", "displayName", "provider", "redeemedAt"]
    },
    "TenantProfile": {
      "title": "TenantProfile",
      "description": "Isolated business store workspace profile and configuration.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ownerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 0, "maxLength": 120 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "role": { "type": "string", "enum": ["super_admin", "store_owner", "manager", "staff", "viewer", "owner", "admin", "user"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "invitationId": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "currency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "usdToEgpRate": { "type": "number" },
        "legacyCurrency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "language": { "type": "string", "enum": ["en", "ar"] },
        "exchangeRateMode": { "type": "string", "enum": ["cbe_official", "manual_override"] },
        "cbeBuyRate": { "type": "number" },
        "cbeSellRate": { "type": "number" },
        "cbePublicationDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "cbeLastSyncedAt": { "type": "string", "minLength": 1, "maxLength": 40 },
        "cbeSource": { "type": "string", "minLength": 1, "maxLength": 80 },
        "taxRate": { "type": "number" },
        "lowStockThreshold": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessName", "ownerEmail", "currency", "taxRate", "lowStockThreshold", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog SKU item belonging to a single merchant tenant.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "stock": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "imageKey": { "type": "string", "minLength": 0, "maxLength": 60 },
        "description": { "type": "string", "minLength": 0, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "sku", "category", "price", "cost", "stock", "status", "imageKey", "description", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer CRM profile record private to a merchant tenant.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 0, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 40 },
        "location": { "type": "string", "minLength": 0, "maxLength": 120 },
        "shippingAddress": { "type": "string", "minLength": 0, "maxLength": 240 },
        "city": { "type": "string", "minLength": 0, "maxLength": 80 },
        "country": { "type": "string", "minLength": 0, "maxLength": 80 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "email", "phone", "location", "notes", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Merchant order summary record with customer contact, discounts, stock tracking, and financials.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerEmail": { "type": "string", "minLength": 0, "maxLength": 160 },
        "customerPhone": { "type": "string", "minLength": 0, "maxLength": 40 },
        "shippingAddress": { "type": "string", "minLength": 0, "maxLength": 240 },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled", "returned"] },
        "channel": { "type": "string", "enum": ["Direct Store", "Wholesale", "Marketplace", "Manual"] },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "shippingCost": { "type": "number" },
        "totalAmount": { "type": "number" },
        "totalCost": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "exchangeRate": { "type": "number" },
        "convertedAmount": { "type": "number" },
        "reportingCurrency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "rateSource": { "type": "string", "minLength": 1, "maxLength": 120 },
        "conversionDirection": { "type": "string", "minLength": 3, "maxLength": 20 },
        "ratePublicationDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "rateTimestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
        "itemCount": { "type": "integer" },
        "itemsSummary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "orderDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 500 },
        "stockDeducted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "orderNumber", "customerId", "customerName", "customerEmail", "customerPhone", "shippingAddress", "status", "channel", "subtotal", "discountAmount", "taxAmount", "shippingCost", "totalAmount", "totalCost", "itemCount", "itemsSummary", "orderDate", "notes", "stockDeducted", "createdAt", "updatedAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Line item with product variant belonging to an order subcollection.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 40 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" },
        "unitCost": { "type": "number" },
        "lineTotal": { "type": "number" }
      },
      "required": ["ownerId", "productId", "productName", "sku", "variant", "quantity", "unitPrice", "unitCost", "lineTotal"]
    },
    "OrderHistoryEntry": {
      "title": "OrderHistoryEntry",
      "description": "Immutable status and edit audit entry under an order subcollection.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled", "returned"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "detail": { "type": "string", "minLength": 0, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "status", "title", "detail", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense record private to a merchant tenant.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["Marketing", "Shipping", "Packaging", "Software", "Operations", "Other", "Inventory", "Payroll"] },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "exchangeRate": { "type": "number" },
        "convertedAmount": { "type": "number" },
        "reportingCurrency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "rateSource": { "type": "string", "minLength": 1, "maxLength": 120 },
        "conversionDirection": { "type": "string", "minLength": 3, "maxLength": 20 },
        "ratePublicationDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "rateTimestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
        "expenseDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "notes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "category", "vendor", "amount", "expenseDate", "status", "notes", "createdAt", "updatedAt"]
    },
    "BusinessActivity": {
      "title": "BusinessActivity",
      "description": "Audit trail event for tenant actions.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["order", "product", "expense", "inventory", "customer", "settings"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "detail": { "type": "string", "minLength": 0, "maxLength": 250 },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "type", "title", "detail", "amount", "createdAt"]
    },
    "ProductIdea": {
      "title": "ProductIdea",
      "description": "Product research margin feasibility entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetPrice": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "shippingEstimate": { "type": "number" },
        "adCpaEstimate": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "EGP", "EUR", "GBP", "CAD", "AUD"] },
        "notes": { "type": "string", "minLength": 0, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "targetPrice", "estimatedCost", "shippingEstimate", "adCpaEstimate", "notes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Read-only platform owner and super-admin lookup documents provisioned out-of-band."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Independent user profiles with RBAC role, account status, assigned store tenantId, and granular section permissions."
    },
    "/roleTemplates/{roleId}": {
      "schema": { "$ref": "#/entities/RoleTemplate" },
      "description": "Customizable role permission templates managed exclusively by Super Admin."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable append-only audit log recording all Super Admin actions and audited store inspections."
    },
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Hashed invitation records keyed by SHA-256 hex digest of secret invitation code."
    },
    "/invitations/{inviteId}/redemptions/{redeemerUid}": {
      "schema": { "$ref": "#/entities/InvitationRedemption" },
      "description": "Immutable redemption audit records isolated per redeeming user UID."
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/TenantProfile" },
      "description": "Root store workspace document owned by store owner or accessed by authorized store members."
    },
    "/tenants/{tenantId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/TenantMember" },
      "description": "Authorized team members (manager, staff, viewer) assigned to a specific store tenant."
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Private product catalog items isolated per store tenant."
    },
    "/tenants/{tenantId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Private customer records isolated per store tenant."
    },
    "/tenants/{tenantId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Private order records isolated per store tenant."
    },
    "/tenants/{tenantId}/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Order line items isolated under parent order and tenant."
    },
    "/tenants/{tenantId}/orders/{orderId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/OrderHistoryEntry" },
      "description": "Immutable order status and edit history log isolated under parent order and tenant."
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Private business expenses isolated per store tenant."
    },
    "/tenants/{tenantId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/BusinessActivity" },
      "description": "Private business activity log isolated per store tenant."
    },
    "/tenants/{tenantId}/researchIdeas/{ideaId}": {
      "schema": { "$ref": "#/entities/ProductIdea" },
      "description": "Private product research margin ideas isolated per store tenant."
    }
  }
}
